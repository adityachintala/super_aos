---
// A left-to-right pipeline drawn as a row of sticky notes joined by arrows.
import Icon from '@/components/Icon.astro';

interface Step {
  label: string;
  note?: string;
}
interface Props {
  steps: Step[];
  caption?: string;
}
const { steps, caption } = Astro.props;
const NOTES = ['var(--note-yellow)', 'var(--note-teal)', 'var(--note-rose)', 'var(--note-orange)', 'var(--note-lilac)', 'var(--note-mint)'];
---

<figure class="not-sw-prose my-8">
  <ol class="flex flex-wrap items-stretch gap-y-3">
    {
      steps.map((s, i) => (
        <li class="flex items-center">
          {i > 0 && <Icon name="arrowRight" class="text-muted-foreground mx-1.5 size-5" />}
          <div
            class="text-note-ink grid h-full max-w-48 content-center gap-0.5 rounded-[3px_3px_14px_3px] px-3.5 py-2.5 text-sm shadow-sm"
            style={`background:${NOTES[i % NOTES.length]};rotate:${i % 2 ? 0.8 : -0.8}deg`}
          >
            <span class="font-semibold">{s.label}</span>
            {s.note && <span class="text-xs opacity-80">{s.note}</span>}
          </div>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="hand text-muted-foreground mt-3 text-center text-xl">{caption}</figcaption>}
</figure>
