---
// A simple left-to-right pipeline diagram: boxes joined by arrows.
import Icon from '@/components/Icon.astro';

interface Step {
  label: string;
  note?: string;
}
interface Props {
  steps: Step[];
  caption?: string;
}
const { steps, caption } = Astro.props;
---

<figure class="not-sw-prose my-6">
  <ol class="flex flex-wrap items-stretch gap-y-2">
    {
      steps.map((s, i) => (
        <li class="flex items-center">
          {i > 0 && <Icon name="arrowRight" class="text-muted-foreground mx-1.5 size-4" />}
          <div class="bg-card ring-border grid h-full max-w-44 content-center gap-0.5 rounded-lg px-3 py-2 text-sm ring-1">
            <span class="font-medium">{s.label}</span>
            {s.note && <span class="text-muted-foreground text-xs">{s.note}</span>}
          </div>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="text-muted-foreground mt-2 text-center text-sm">{caption}</figcaption>}
</figure>
