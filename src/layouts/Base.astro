---
import { BASE } from '../lib/base';
import '@/styles/starwind.css';
import 'katex/dist/katex.min.css';
import '@fontsource-variable/figtree';
import '@fontsource-variable/caveat';
import { ThemeInitScript } from '@starwind-ui/astro/theme';
import { Button } from '@/components/starwind/button';
import { ThemeToggle } from '@/components/starwind/theme-toggle';
import Icon from '@/components/Icon.astro';
import StatsBar from '@/components/learn/StatsBar.svelte';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'An interactive, visual course on Advanced Operating Systems.' } = Astro.props;
const fullTitle = title ? `${title} · Super AOS` : 'Super AOS · Learn Advanced Operating Systems';

// Link previews need absolute URLs. `site` comes from astro.config.mjs.
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(`${BASE}/og.png`, origin).href; // made by scripts/make-og.ts
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={pageUrl} />

    <meta property="og:site_name" content="Super AOS" />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Super AOS: operating systems, one small bite at a time. Three sticky notes read: read one bite, play with it, prove it." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23ffd02f'/><text x='16' y='22' font-size='16' font-weight='700' font-family='sans-serif' text-anchor='middle' fill='%231c1c1e'>OS</text></svg>"
    />
    <ThemeInitScript />
  </head>
  <body class="min-h-screen antialiased">
    {/* Wobbly-ink filter used by every doodle (class "sketch"). */}
    <svg width="0" height="0" class="absolute" aria-hidden="true">
      <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.8"></feDisplacementMap>
      </filter>
    </svg>
    <header class="bg-card/90 sticky top-0 z-40 border-b backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4">
        <a href={`${BASE}/`} class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <span class="bg-brand text-note-ink grid size-8 -rotate-6 place-items-center rounded-lg shadow-sm"><Icon name="brain" class="size-5" /></span>
          <span>Super AOS</span>
        </a>
        <nav class="ml-2 hidden items-center md:flex" aria-label="Main">
          <Button href={`${BASE}/`} variant="ghost" size="sm">Course map</Button>
          <Button href={`${BASE}/review`} variant="ghost" size="sm">Review</Button>
          <Button href={`${BASE}/pyq`} variant="ghost" size="sm">Past quizzes</Button>
          <Button href={`${BASE}/exam`} variant="ghost" size="sm">Mock exam</Button>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <StatsBar client:load />
          <ThemeToggle size="sm" ariaLabel="Switch between light and dark theme" />
        </div>
      </div>
    </header>

    <slot />

    <footer class="bg-note-ink mt-24 px-4 py-12 text-center text-sm text-white/70">
      <p class="hand text-brand text-3xl">Little bites, every day.</p>
      <p class="mx-auto mt-2 max-w-xl">Super AOS is a free study companion for Advanced Operating Systems. Your progress is stored only in this browser.</p>
    </footer>
  </body>
</html>
