---
import { BASE } from '../../lib/base';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/starwind/breadcrumb';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import Icon from '@/components/Icon.astro';
import LessonTracker from '@/components/learn/LessonTracker.svelte';
import ReaderBar from '@/components/learn/ReaderBar.svelte';
import ReaderNav from '@/components/learn/ReaderNav.svelte';
import Doodle from '@/components/Doodle.astro';
import { allLessons, findLesson } from '@/lib/course';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = findLesson(entry.id);
if (!meta) throw new Error(`Lesson "${entry.id}" is not listed in src/lib/course.ts`);

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const published = new Set((await getCollection('lessons')).map((l) => l.id));
const ordered = allLessons.filter((l) => published.has(l.id));
const pos = ordered.findIndex((l) => l.id === entry.id);
const prev = ordered[pos - 1];
const next = ordered[pos + 1];
const prereqs = entry.data.prerequisites.map((id) => ({ id, lesson: findLesson(id), open: published.has(id) }));
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <main class="min-w-0 pt-8">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem><BreadcrumbLink href={`${BASE}/`}>Course map</BreadcrumbLink></BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem><BreadcrumbPage>Unit {meta.unit.id}: {meta.unit.title}</BreadcrumbPage></BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>

      <header class="mt-4">
        <div class="grid items-start gap-6 sm:grid-cols-[1fr_auto]">
          <div>
            <p class="text-note-ink inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold tracking-wider uppercase" style={`background:${meta.unit.note}`}>
              Unit {meta.unit.id} · {meta.unit.title}
            </p>
            <h1 class="mt-3 text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">{entry.data.title}</h1>
            <div class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
              <span class="flex items-center gap-1.5"><Icon name="clock" />about {entry.data.minutes} min, in short bites</span>
              <LessonTracker client:load lessonId={entry.id} />
            </div>
          </div>
          <Doodle name={meta.doodle} class="hidden size-32 sm:block" />
        </div>

        <div class="stickynote mt-8 max-w-xl px-6 pt-7 pb-5" style="--note: var(--note-yellow); --tilt: -0.8deg">
          <p class="hand text-2xl opacity-70">The big idea</p>
          <p class="mt-1 text-xl leading-snug font-medium">{meta.hook}</p>
        </div>

        <details class="deep bg-card mt-8 rounded-2xl border">
          <summary class="flex items-center gap-3 rounded-2xl px-4 py-3 outline-none focus-visible:ring-3 focus-visible:ring-outline/50">
            <Icon name="arrowRight" class="deep-chevron text-muted-foreground size-4 shrink-0 transition-transform" />
            <span class="font-medium">What you will be able to do after this lesson</span>
          </summary>
          <div class="border-t px-4 py-4 sm:px-6">
            <p class="text-muted-foreground">{entry.data.summary}</p>
            <ul class="mt-3 grid gap-2">
              {
                entry.data.objectives.map((o) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="text-primary-accent mt-1 size-4" />
                    <span>{o}</span>
                  </li>
                ))
              }
            </ul>
            {
              prereqs.length > 0 && (
                <p class="text-muted-foreground mt-4 text-sm">
                  <span class="text-foreground font-medium">Helps to know first:</span>{' '}
                  {prereqs.map((p, i) => (
                    <>
                      {i > 0 && ', '}
                      {p.open ? (
                        <a class="text-primary-accent underline underline-offset-2" href={`${BASE}/learn/${p.id}`}>
                          {p.lesson?.title ?? p.id}
                        </a>
                      ) : (
                        <span>{p.lesson?.title ?? p.id}</span>
                      )}
                    </>
                  ))}
                </p>
              )
            }
          </div>
        </details>
      </header>

      <ReaderBar client:load lessonId={entry.id} />

      <Prose class="lesson mt-6 max-w-none text-lg">
        <Content />
      </Prose>

      {/* Shows the right section before the page's scripts load, so the whole lesson never flashes up. */}
      <script is:inline data-lesson={entry.id}>
        (function () {
          try {
            var id = document.currentScript.dataset.lesson;
            var p = JSON.parse(localStorage.getItem('super-aos-reader') || '{}');
            var el = document.querySelector('.lesson');
            if (!el) return;
            if (p.size === 'large') el.dataset.size = 'large';
            if (p.mode === 'all') return;
            var bites = el.querySelectorAll(':scope > .bite');
            if (!bites.length) return;
            var i = Math.min((p.at && p.at[id]) || 0, bites.length - 1);
            var target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
            var bite = target && target.closest('.bite');
            if (bite) i = [].indexOf.call(bites, bite);
            bites[i].setAttribute('data-current', '');
            el.classList.add('stepping');
          } catch (e) {}
        })();
      </script>

      <ReaderNav client:load />

      <nav class="mt-12 flex flex-wrap justify-between gap-3" aria-label="Lesson navigation">
        {
          prev ? (
            <Button variant="outline" href={`${BASE}/learn/${prev.id}`}>
              <Icon name="arrowLeft" />
              {prev.title}
            </Button>
          ) : (
            <Button variant="outline" href={`${BASE}/`}>
              <Icon name="arrowLeft" />
              Course map
            </Button>
          )
        }
        {
          next ? (
            <Button variant="primary" href={`${BASE}/learn/${next.id}`}>
              {next.title}
              <Icon name="arrowRight" />
            </Button>
          ) : (
            <Button variant="primary" href={`${BASE}/`}>
              Back to course map
              <Icon name="arrowRight" />
            </Button>
          )
        }
      </nav>
    </main>

    <aside class="hidden lg:block">
      <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pt-8 text-sm" aria-label="On this page">
        <p class="text-muted-foreground text-xs font-medium tracking-wider uppercase">On this page</p>
        <ol class="mt-3 grid border-l">
          {
            toc.map((h) => (
              <li>
                <a class="toc-link text-muted-foreground hover:text-foreground -ml-px block border-l border-transparent py-1 pl-3" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))
          }
          <li>
            <a class="toc-link text-muted-foreground hover:text-foreground -ml-px flex items-center gap-1.5 border-l border-transparent py-1 pl-3" href="#checkpoint">
              <Icon name="flag" class="size-3.5" />Checkpoint
            </a>
          </li>
        </ol>
      </nav>
    </aside>
  </div>

  <style is:global>
    .toc-link[aria-current='true'] {
      border-color: var(--primary);
      color: var(--foreground);
      font-weight: 500;
    }
  </style>

  <script>
    // Highlight the section currently being read in the table of contents.
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach((a) => links.set(a.hash.slice(1), a));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const mark = () => {
      // Only headings that are on screen count: in step mode the other sections are hidden.
      const visible = targets.filter((el) => el.offsetParent !== null);
      let current = visible[0];
      for (const el of visible) if (el.getBoundingClientRect().top < 200) current = el;
      links.forEach((a, id) => (id === current?.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    document.addEventListener('scroll', mark, { passive: true });
    document.addEventListener('reader:change', mark);
    mark();
  </script>
</Base>
