---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/starwind/breadcrumb';
import { Button } from '@/components/starwind/button';
import { Card, CardContent } from '@/components/starwind/card';
import { Prose } from '@/components/starwind/prose';
import Icon from '@/components/Icon.astro';
import LessonTracker from '@/components/learn/LessonTracker.svelte';
import { allLessons, findLesson } from '@/lib/course';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = findLesson(entry.id);
if (!meta) throw new Error(`Lesson "${entry.id}" is not listed in src/lib/course.ts`);

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const published = new Set((await getCollection('lessons')).map((l) => l.id));
const ordered = allLessons.filter((l) => published.has(l.id));
const pos = ordered.findIndex((l) => l.id === entry.id);
const prev = ordered[pos - 1];
const next = ordered[pos + 1];
const prereqs = entry.data.prerequisites.map((id) => ({ id, lesson: findLesson(id), open: published.has(id) }));
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <main class="min-w-0 pt-8">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem><BreadcrumbLink href="/">Course map</BreadcrumbLink></BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem><BreadcrumbPage>Unit {meta.unit.id}: {meta.unit.title}</BreadcrumbPage></BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>

      <header class="mt-4 border-b pb-8">
        <h1 class="text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
        <p class="text-muted-foreground mt-2 max-w-2xl text-lg">{entry.data.summary}</p>
        <div class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="flex items-center gap-1.5"><Icon name="clock" />about {entry.data.minutes} min</span>
          <LessonTracker client:load lessonId={entry.id} />
        </div>

        {
          entry.data.objectives.length > 0 && (
            <Card size="sm" class="mt-6 text-base">
              <CardContent>
                <p class="text-muted-foreground text-xs font-medium tracking-wider uppercase">After this lesson you can</p>
                <ul class="mt-3 grid gap-2">
                  {entry.data.objectives.map((o) => (
                    <li class="flex gap-2">
                      <Icon name="check" class="text-primary-accent mt-1 size-4" />
                      <span>{o}</span>
                    </li>
                  ))}
                </ul>
                {prereqs.length > 0 && (
                  <p class="text-muted-foreground mt-4 text-sm">
                    <span class="text-foreground font-medium">Helps to know first:</span>{' '}
                    {prereqs.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        {p.open ? (
                          <a class="text-primary-accent underline underline-offset-2" href={`/learn/${p.id}`}>
                            {p.lesson?.title ?? p.id}
                          </a>
                        ) : (
                          <span>{p.lesson?.title ?? p.id}</span>
                        )}
                      </>
                    ))}
                  </p>
                )}
              </CardContent>
            </Card>
          )
        }
      </header>

      <Prose class="lesson mt-8 max-w-none text-lg">
        <Content />
      </Prose>

      <nav class="mt-12 flex flex-wrap justify-between gap-3" aria-label="Lesson navigation">
        {
          prev ? (
            <Button variant="outline" href={`/learn/${prev.id}`}>
              <Icon name="arrowLeft" />
              {prev.title}
            </Button>
          ) : (
            <Button variant="outline" href="/">
              <Icon name="arrowLeft" />
              Course map
            </Button>
          )
        }
        {
          next ? (
            <Button variant="primary" href={`/learn/${next.id}`}>
              {next.title}
              <Icon name="arrowRight" />
            </Button>
          ) : (
            <Button variant="primary" href="/">
              Back to course map
              <Icon name="arrowRight" />
            </Button>
          )
        }
      </nav>
    </main>

    <aside class="hidden lg:block">
      <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pt-8 text-sm" aria-label="On this page">
        <p class="text-muted-foreground text-xs font-medium tracking-wider uppercase">On this page</p>
        <ol class="mt-3 grid border-l">
          {
            toc.map((h) => (
              <li>
                <a class="toc-link text-muted-foreground hover:text-foreground -ml-px block border-l border-transparent py-1 pl-3" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))
          }
          <li>
            <a class="toc-link text-muted-foreground hover:text-foreground -ml-px flex items-center gap-1.5 border-l border-transparent py-1 pl-3" href="#checkpoint">
              <Icon name="flag" class="size-3.5" />Checkpoint
            </a>
          </li>
        </ol>
      </nav>
    </aside>
  </div>

  <style is:global>
    .toc-link[aria-current='true'] {
      border-color: var(--primary);
      color: var(--foreground);
      font-weight: 500;
    }
  </style>

  <script>
    // Highlight the section currently being read in the table of contents.
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach((a) => links.set(a.hash.slice(1), a));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const mark = () => {
      let current = targets[0];
      for (const el of targets) if (el.getBoundingClientRect().top < 140) current = el;
      links.forEach((a, id) => (id === current?.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    document.addEventListener('scroll', mark, { passive: true });
    mark();
  </script>
</Base>
