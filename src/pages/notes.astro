---
import { BASE } from '../lib/base';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/starwind/breadcrumb';
import { Prose } from '@/components/starwind/prose';
import Doodle from '@/components/Doodle.astro';
import Icon from '@/components/Icon.astro';
import { units } from '@/lib/course';
import { bank } from '@/lib/bank';

// One short set of notes per lesson: the lesson's own summary.
const summaries = new Map((await getCollection('summaries')).map((s) => [s.id, s]));
const text = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');

const chapters = await Promise.all(
  units.map(async (unit) => ({
    unit,
    lessons: await Promise.all(
      unit.lessons.map(async (lesson, i) => {
        const entry = summaries.get(lesson.id);
        if (!entry) throw new Error(`No summary for lesson "${lesson.id}" in src/content/summaries`);
        const { Content } = await render(entry);
        const asked = bank
          .filter((x) => x.lessonId === lesson.id && x.q.pastPaper)
          .map((x) => ({ prompt: text(x.q.prompt), source: x.q.source, marks: x.q.type === 'written' ? x.q.marks : undefined }));
        return { lesson, number: i + 1, Content, asked };
      }),
    ),
  })),
);
const total = chapters.reduce((n, c) => n + c.lessons.length, 0);
---

<Base title="Revision notes" description="Short revision notes for every chapter of Advanced Operating Systems, with the questions that have been asked on each.">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <main class="min-w-0 pt-8">
      <div class="no-print">
        <Breadcrumb>
          <BreadcrumbList>
            <BreadcrumbItem><BreadcrumbLink href={`${BASE}/`}>Course map</BreadcrumbLink></BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem><BreadcrumbPage>Revision notes</BreadcrumbPage></BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
      </div>

      <header class="mt-4 grid items-start gap-6 sm:grid-cols-[1fr_auto]">
        <div>
          <h1 class="text-4xl leading-[1.08] font-semibold tracking-tight sm:text-5xl">Revision notes</h1>
          <p class="text-muted-foreground mt-3 max-w-2xl text-lg">
            All {total} chapters on one page. Each is a short list of what to remember, followed by what has been asked on it before. Read a
            chapter in about two minutes.
          </p>
          <div class="no-print mt-5 flex flex-wrap gap-2">
            <button
              type="button"
              id="print-notes"
              class="bg-primary text-primary-foreground inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium outline-none focus-visible:ring-3 focus-visible:ring-outline/50"
            >
              <Icon name="pencil" class="size-4" />Print or save as PDF
            </button>
            <a class="bg-card inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium" href={`${BASE}/review`}>
              <Icon name="bolt" class="size-4" />Test yourself with flashcards
            </a>
          </div>
        </div>
        <Doodle name="cards" class="no-print hidden size-32 sm:block" />
      </header>

      {
        chapters.map(({ unit, lessons }) => (
          <section class="mt-12" id={`unit-${unit.id}`}>
            <h2 class="flex items-center gap-3 text-2xl font-semibold tracking-tight sm:text-3xl">
              <span class="text-note-ink grid size-11 shrink-0 -rotate-6 place-items-center rounded-2xl text-lg font-bold shadow-sm" style={`background:${unit.note}`}>
                {unit.id}
              </span>
              {unit.title}
            </h2>

            {lessons.map(({ lesson, number, Content, asked }) => (
              <article class="notes-card bg-card mt-5 rounded-[28px] border p-5 shadow-sm sm:p-8" id={lesson.id}>
                <header class="flex items-start gap-4">
                  <Doodle name={lesson.doodle} class="size-14 shrink-0" />
                  <div class="min-w-0">
                    <p class="text-muted-foreground text-xs font-semibold tracking-wider uppercase">
                      Unit {unit.id} · Lesson {number}
                    </p>
                    <h3 class="text-2xl leading-tight font-semibold tracking-tight">{lesson.title}</h3>
                    <p class="hand text-muted-foreground mt-1 text-xl">{lesson.hook}</p>
                  </div>
                </header>

                <Prose class="notes mt-5 max-w-none">
                  <Content />
                </Prose>

                {asked.length > 0 && (
                  <details class="deep bg-muted/50 mt-6 rounded-2xl border border-dashed" open>
                    <summary class="flex items-center gap-3 rounded-2xl px-4 py-3 outline-none focus-visible:ring-3 focus-visible:ring-outline/50">
                      <Icon name="arrowRight" class="deep-chevron text-muted-foreground size-4 shrink-0 transition-transform" />
                      <span class="font-semibold">
                        Asked before <span class="text-muted-foreground font-normal">({asked.length})</span>
                      </span>
                    </summary>
                    <ul class="grid gap-2 border-t border-dashed px-4 py-4 text-sm sm:px-6">
                      {asked.map((a) => (
                        <li class="flex gap-2">
                          <Icon name="target" class="text-muted-foreground mt-0.5 size-4 shrink-0" />
                          <span>
                            {a.prompt}
                            {(a.source || a.marks) && (
                              <span class="text-muted-foreground"> [{[a.source, a.marks && `${a.marks} marks`].filter(Boolean).join(' · ')}]</span>
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )}

                <p class="no-print mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
                  <a class="text-primary-accent underline underline-offset-2" href={`${BASE}/learn/${lesson.id}`}>
                    Open the full lesson
                  </a>
                  <a class="text-primary-accent underline underline-offset-2" href={`${BASE}/learn/${lesson.id}#checkpoint`}>
                    Take the checkpoint
                  </a>
                  {asked.length > 0 && (
                    <a class="text-primary-accent underline underline-offset-2" href={`${BASE}/pyq#unit-${unit.id}`}>
                      See the model answers
                    </a>
                  )}
                </p>
              </article>
            ))}
          </section>
        ))
      }
    </main>

    <aside class="no-print hidden lg:block">
      <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pt-8 text-sm" aria-label="Chapters">
        <p class="text-muted-foreground text-xs font-medium tracking-wider uppercase">Jump to</p>
        {
          chapters.map(({ unit, lessons }) => (
            <div class="mt-4">
              <a class="font-semibold hover:underline" href={`#unit-${unit.id}`}>
                {unit.id}. {unit.title}
              </a>
              <ol class="mt-1 grid border-l">
                {lessons.map(({ lesson }) => (
                  <li>
                    <a class="text-muted-foreground hover:text-foreground -ml-px block border-l border-transparent py-0.5 pl-3" href={`#${lesson.id}`}>
                      {lesson.title}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </nav>
    </aside>
  </div>

  <script>
    document.getElementById('print-notes')?.addEventListener('click', () => window.print());
  </script>
</Base>
